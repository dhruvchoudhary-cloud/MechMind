# API & Backend Configuration
PROJECT_NAME="Predict Before Failure - Autonomous Maintenance Agent"
VERSION=1.0.0
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./predict_maintenance.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ML Artifact (Path resolves automatically relative to repository root)
ML_MODEL_PATH=ml/artifacts/isolation_forest_v1.joblib
MODEL_METADATA_PATH=ml/artifacts/model_metadata.json
MODEL_VERSION=iforest-v1.0

# Configurable Demonstration Thresholds
TEMP_WARNING_C=70.0
TEMP_CRITICAL_C=85.0
VIBRATION_WARNING_RMS=4.0
VIBRATION_CRITICAL_RMS=6.5
CURRENT_MIN_A=2.0
CURRENT_MAX_A=15.0
RPM_MIN=1000.0
RPM_MAX=1800.0
SIMULATION_INTERVAL_SEC=2.5

# Frontend Environment Variable
VITE_API_BASE_URL=http://localhost:8000/api/v1
